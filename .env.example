# ARIA + Agent Team — environment configuration
# Copy this file to `.env` and fill in real values. `.env` is gitignored.

# --- Global run mode --------------------------------------------------------
# When True (default), consequential actions are logged, not executed, and
# Slack writes are printed instead of sent. Set to False to actually post.
DRY_RUN=TRUE

# --- Slack ------------------------------------------------------------------
# Bot token from your Slack app (starts with xoxb-). Needs scopes:
# chat:write, chat:write.customize, channels:history, channels:read,
# reactions:read, app_mentions:read.
SLACK_BOT_TOKEN=xoxb-your-bot-token-here

# App-level token for Socket Mode (starts with xapp-). Not used in Step 1;
# needed once the daemon listens for events.
SLACK_APP_TOKEN=xapp-your-app-token-here

# --- Web search (ARIA Level 1) ----------------------------------------------
# Tavily API key from tavily.com (free tier: 1000 searches/month). Lets ARIA
# answer questions that need current/external info by searching and narrating
# real results. Leave blank to disable — ARIA then declines web questions
# gracefully rather than guessing. Starts with "tvly-".
TAVILY_API_KEY=tvly-your-key-here

# Channel IDs (e.g. C0123ABCD) — required by conversations_history and
# reactions_get, which do NOT accept "#name". Find each via the channel's
# "Copy link" in Slack (the ID is the last path segment) or the API.
CHANNEL_ID_FEEDBACK=C000000FEEDBACK
CHANNEL_ID_SUPPORT_INTEL=C000SUPPORTINTEL
CHANNEL_ID_DEV=C0000000000DEV
CHANNEL_ID_CONTENT=C00000CONTENT
CHANNEL_ID_ADS=C0000000000ADS
CHANNEL_ID_APPROVALS=C0000APPROVALS
CHANNEL_ID_OPS=C0BGA4SSA5U  # daemon posts crash alerts to #ops
# Conversation-mode transcript channels (create these, then paste their IDs).
CHANNEL_ID_CHAT_SARAH=C0BGMJ5RW2V
CHANNEL_ID_CHAT_BOBBY=C0BGKLR7DTL
CHANNEL_ID_CHAT_AVA=C0BGGC6GEAH
CHANNEL_ID_CHAT_TOM=C0BGGC91M45

# --- Reserved for later build steps (not used in Step 1) --------------------
# Hermes / Ollama
# OLLAMA_URL=http://localhost:11434/api/chat
# HERMES_MODEL=hermes3

# Google Drive (Ava)
# GOOGLE_CREDENTIALS_JSON=path/to/credentials.json
# GDRIVE_FOOTAGE_FOLDER_ID=your-drive-folder-id

# Metricool (Ava)
# METRICOOL_API_TOKEN=your-metricool-token
# METRICOOL_BLOG_ID=your-metricool-blog-id

# Ads platform (Bobby)
# META_ACCESS_TOKEN=your-meta-marketing-api-token
# META_AD_ACCOUNT_ID=act_0000000000
# MAX_DAILY_BUDGET_DELTA=15
# MAX_TOTAL_DAILY_SPEND=200

# --- Voice / TTS (ARIA — Step 6) --------------------------------------------
# ElevenLabs API key. Get it at elevenlabs.io -> profile -> API Keys.
ELEVENLABS_API_KEY=sk-your-key-here
# ARIA's voice. Copy an ID from elevenlabs.io -> Voice Library.
ELEVENLABS_VOICE_ID=your_voice_id_here

# --- Per-agent voices (Step 7B) ---------------------------------------------
# Each teammate speaks in their own voice during conversation mode. Copy a
# distinct Voice ID for each from elevenlabs.io -> Voice Library. Any left
# unset falls back to ARIA's voice (with a logged warning), so these are
# optional but recommended for distinct agent voices.
SARAH_VOICE_ID=your_voice_id_here
TOM_VOICE_ID=your_voice_id_here
AVA_VOICE_ID=your_voice_id_here
BOBBY_VOICE_ID=your_voice_id_here

# --- ARIA general-assistant model (optional cloud backend) ------------------
# ARIA's FREEFORM path (general knowledge, reasoning, web-search narration) can run
# on Claude Haiku 4.5 instead of local gemma3, where gemma3 fumbles. Everything else
# — agent cycles, deterministic routing, conversation mode, Tavily fetch, Python
# unit conversion — stays gemma3/local regardless. Set to "gemma3" to keep the
# general path free and local too. If "haiku" but the key is missing or the API is
# unreachable, each freeform turn falls back to gemma3 (ARIA never goes silent).
ARIA_GENERAL_MODEL=haiku
# Anthropic API key (starts with sk-ant-). Only used when ARIA_GENERAL_MODEL=haiku.
ANTHROPIC_API_KEY=sk-ant-...your-key...
# Optional overrides:
# HAIKU_MODEL=claude-haiku-4-5-20251001
# HAIKU_MAX_TOKENS=512     # hard per-call output cap (cost guard)
